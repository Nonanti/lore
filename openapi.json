{
  "openapi": "3.1.0",
  "info": {
    "title": "Lore API",
    "description": "An identity + orchestration + memory core for AI agents. All endpoints (except health/ready/openapi) are protected by an optional API key: `X-API-Key` or `Authorization: Bearer`.",
    "version": "0.1.0",
    "license": {
      "name": "MIT"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AgentView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "traits",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ULID"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "description": "Persona version (increments on every update)"
          }
        }
      },
      "PersonaPatch": {
        "type": "object",
        "description": "Partial update \u2014 only the given fields change. name/role cannot be empty (422).",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "system_prompt": {
            "type": "string"
          }
        }
      },
      "MemoryView": {
        "type": "object",
        "required": [
          "id",
          "score",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "AskResp": {
        "type": "object",
        "required": [
          "reply"
        ],
        "properties": {
          "reply": {
            "type": "string"
          }
        }
      },
      "ActResp": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "DeliberateReply": {
        "type": "object",
        "required": [
          "id",
          "name",
          "reply"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "node": {
            "type": "string",
            "description": "URL of the peer node the reply came from (local if absent)"
          }
        }
      },
      "DeliberateResp": {
        "type": "object",
        "required": [
          "replies"
        ],
        "properties": {
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliberateReply"
            }
          },
          "synthesis": {
            "type": "string",
            "description": "Supervisor synthesis (only if a synthesizer was provided)"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "goal",
          "workspace",
          "verify",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ULID identifier"
          },
          "agent": {
            "type": "string",
            "description": "Agent name (persona file stem)"
          },
          "goal": {
            "type": "string",
            "description": "What the agent should achieve"
          },
          "workspace": {
            "type": "string",
            "description": "Sandbox root for this task"
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Verification commands"
          },
          "status": {
            "type": "string",
            "enum": [
              "Queued",
              "Running",
              "WaitingApproval",
              "WaitingSubtasks",
              "Completed",
              "Failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "report": {
            "type": "string",
            "description": "WorkReport JSON (present when Completed or Failed)",
            "nullable": true
          },
          "parent_id": {
            "type": "string",
            "description": "Parent task id (for team hierarchy)",
            "nullable": true
          }
        }
      },
      "TaskFullView": {
        "type": "object",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "$ref": "#/components/schemas/TaskView"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskView"
            },
            "description": "Child tasks (subtasks), empty for standalone"
          }
        }
      },
      "ApprovalEntry": {
        "type": "object",
        "required": [
          "id",
          "task_id",
          "action",
          "reason",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ULID identifier"
          },
          "task_id": {
            "type": "string",
            "description": "Which task this approval belongs to"
          },
          "action": {
            "type": "string",
            "description": "JSON-serialized action being considered"
          },
          "reason": {
            "type": "string",
            "description": "Why the action requires approval"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Denied"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "EnqueueTaskReq": {
        "type": "object",
        "required": [
          "agent",
          "goal"
        ],
        "properties": {
          "agent": {
            "type": "string",
            "description": "Agent name (must not contain '/', '\\', or '..')"
          },
          "goal": {
            "type": "string",
            "description": "Goal description (non-empty)"
          },
          "workspace": {
            "type": "string",
            "description": "Workspace root (defaults to <data>/workspaces/<agent>). An absolute path outside data_dir will be rejected at enqueue time (422)."
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Verification commands (optional)",
            "default": []
          }
        }
      },
      "TaskView": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "goal",
          "workspace",
          "verify",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ULID identifier"
          },
          "agent": {
            "type": "string",
            "description": "Agent name (persona file stem)"
          },
          "goal": {
            "type": "string",
            "description": "What the agent should achieve"
          },
          "workspace": {
            "type": "string",
            "description": "Workspace path (relative to data_dir; basename if outside)"
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Verification commands"
          },
          "status": {
            "type": "string",
            "enum": [
              "Queued",
              "Running",
              "WaitingApproval",
              "WaitingSubtasks",
              "Completed",
              "Failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "report": {
            "type": "string",
            "description": "WorkReport JSON (present when Completed or Failed)",
            "nullable": true
          },
          "parent_id": {
            "type": "string",
            "description": "Parent task id (for team hierarchy)",
            "nullable": true
          }
        }
      },
      "CompactTaskView": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "goal",
          "workspace",
          "verify",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ULID identifier"
          },
          "agent": {
            "type": "string",
            "description": "Agent name"
          },
          "goal": {
            "type": "string",
            "description": "Goal description"
          },
          "workspace": {
            "type": "string",
            "description": "Workspace path (relative to data_dir)"
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Verification commands"
          },
          "status": {
            "type": "string",
            "enum": [
              "Queued",
              "Running",
              "WaitingApproval",
              "WaitingSubtasks",
              "Completed",
              "Failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "parent_id": {
            "type": "string",
            "description": "Parent task id (for team hierarchy)",
            "nullable": true
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKey": []
    },
    {
      "bearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness (store access is verified)",
        "security": [],
        "responses": {
          "200": {
            "description": "ready"
          },
          "503": {
            "description": "store unreachable"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This spec",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics (per-route latency histogram, retrieval/consolidation counters)",
        "responses": {
          "200": {
            "description": "text/plain metrics"
          }
        }
      }
    },
    "/agents": {
      "get": {
        "summary": "List agents",
        "responses": {
          "200": {
            "description": "list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "role"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "traits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentView"
                }
              }
            }
          },
          "422": {
            "description": "name/role empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Update persona (version increments)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonaPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentView"
                }
              }
            }
          },
          "404": {
            "description": "no such agent"
          },
          "422": {
            "description": "invalid field"
          }
        }
      },
      "delete": {
        "summary": "Delete the agent (including the persona file)",
        "responses": {
          "204": {
            "description": "deleted"
          },
          "404": {
            "description": "no such agent"
          }
        }
      }
    },
    "/agents/{id}/ask": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Ask the agent (with the memory recall + record loop)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "session": {
                    "type": "string",
                    "description": "Conversation window key (\u2264128 bytes); the same session remembers previous turns"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "reply",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResp"
                }
              }
            }
          },
          "404": {
            "description": "no such agent"
          },
          "422": {
            "description": "session name too long"
          }
        }
      }
    },
    "/agents/{id}/ask/stream": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Get the reply as an SSE token stream (`data: <chunk>` \u2026 `data: [DONE]`)",
        "responses": {
          "200": {
            "description": "text/event-stream"
          }
        }
      }
    },
    "/agents/{id}/act": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Run a tool if one matches, otherwise reply",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActResp"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}/solve": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "ReAct loop: think \u2192 tool \u2192 observe (multi-step)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "max_steps": {
                    "type": "integer",
                    "description": "default 5, cap 10"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "final reply",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActResp"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}/message": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Inter-agent message: ask \u2192 returns a reply, tell \u2192 204 (written to the recipient's memory)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "ask",
                      "tell"
                    ]
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ask reply"
          },
          "204": {
            "description": "tell delivered"
          }
        }
      }
    },
    "/agents/{id}/experience": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Add an episodic memory (explicit record \u2014 standard importance)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "memory recorded"
          }
        }
      }
    },
    "/agents/{id}/recall": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "q",
          "in": "query",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer",
            "maximum": 1000
          }
        },
        {
          "name": "semantic",
          "in": "query",
          "schema": {
            "type": "boolean"
          },
          "description": "Semantic recall (including morphology) \u2014 retrieves even when the keyword doesn't match"
        }
      ],
      "get": {
        "summary": "Recall from memory (hybrid retrieval)",
        "responses": {
          "200": {
            "description": "scored records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemoryView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/deliberate": {
      "post": {
        "summary": "Collective reasoning: the whole team replies (+optional supervisor synthesis, +federation)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "question"
                ],
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "local": {
                    "type": "boolean",
                    "description": "true: peer fanout is skipped (depth-1 guarantee \u2014 also holds with a synthesizer)"
                  },
                  "synthesizer": {
                    "type": "string",
                    "description": "This agent doesn't join the poll; it synthesizes the replies"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "replies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliberateResp"
                }
              }
            }
          }
        }
      }
    },
    "/deliberate/live": {
      "get": {
        "summary": "WebSocket live deliberate: the first text frame is the question (\u226464KB, within 30 s); replies stream as DeliberateReply JSON frames as they become ready, with [DONE] at the end",
        "responses": {
          "101": {
            "description": "WebSocket upgrade"
          }
        }
      }
    },
    "/board": {
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "schema": {
            "type": "integer",
            "maximum": 1000
          }
        }
      ],
      "get": {
        "summary": "Read the shared board (World)",
        "responses": {
          "200": {
            "description": "scored records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemoryView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}/reinforce": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Memory reinforcement: feeding the decay/Wilson signals. Scope-validated \u2014 only the agent's own record or World can be reinforced (another agent's returns 404).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "memory_id",
                  "outcome"
                ],
                "properties": {
                  "memory_id": {
                    "type": "string",
                    "description": "Memory record ULID (the id from the recall output)"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "accessed",
                      "success",
                      "failure"
                    ],
                    "description": "accessed: access (refreshes decay) \u00b7 success/failure: procedural Wilson feeding"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "reinforced"
          },
          "404": {
            "description": "agent or record not found (another agent's record also returns 404)"
          },
          "422": {
            "description": "invalid outcome or body"
          }
        }
      }
    },
    "/agents/{id}/reflect": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Reflection: distills frequently recalled (access \u2265 2) episodic memories via the model and promotes them to the semantic tier; the originals are archived via soft-delete.",
        "responses": {
          "200": {
            "description": "number of distilled memories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "distilled"
                  ],
                  "properties": {
                    "distilled": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "agent not found"
          }
        }
      }
    },
    "/tasks": {
      "post": {
        "summary": "Enqueue a new task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnqueueTaskReq"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "task enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskView"
                }
              }
            }
          },
          "422": {
            "description": "empty agent/goal or path traversal in agent name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "task store not configured"
          }
        }
      },
      "get": {
        "summary": "List tasks (compact, newest-first)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompactTaskView"
                  }
                }
              }
            }
          },
          "503": {
            "description": "task store not configured"
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get a full task record (incl. report + children)",
        "responses": {
          "200": {
            "description": "full task view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskFullView"
                }
              }
            }
          },
          "404": {
            "description": "task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "task store not configured"
          }
        }
      }
    },
    "/tasks/{id}/log": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read task log file (path traversal validated)",
        "parameters": [
          {
            "name": "tail",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Number of lines from the end"
          }
        ],
        "responses": {
          "200": {
            "description": "log content",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "log file not found or invalid task id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "path traversal rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "data directory not configured"
          }
        }
      }
    },
    "/inbox": {
      "get": {
        "summary": "List pending approvals",
        "responses": {
          "200": {
            "description": "pending approvals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalEntry"
                  }
                }
              }
            }
          },
          "503": {
            "description": "task store not configured"
          }
        }
      }
    },
    "/approvals/{id}/approve": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Approve a pending approval (idempotent: non-Pending -> 409)",
        "responses": {
          "204": {
