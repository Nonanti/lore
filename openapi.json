          },
          "409": {
            "description": "already decided (Approved or Denied)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "task store not configured"
          }
        }
      }
    },
    "/approvals/{id}/deny": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Deny a pending approval (idempotent: non-Pending -> 409)",
        "responses": {
          "204": {
            "description": "denied"
          },
          "404": {
            "description": "approval not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "already decided (Approved or Denied)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "task store not configured"
          }
        }
      }
    }
  }
}
